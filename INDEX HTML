        const btnStartExam = document.getElementById("btn-start-exam");

        async function requestMediaPermissions() {
            prepStatusBox.className = "mt-3 p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-xs";
            prepStatusBox.innerHTML = "Meminta izin akses <strong>Kamera</strong> dan <strong>Mikrofon</strong>...";

            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                handleMediaDenied("Browser Anda tidak mendukung akses kamera/mikrofon atau halaman tidak dibuka melalui HTTPS.");
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: "user", width: { ideal: 320 }, height: { ideal: 240 } },
                    audio: true
                });

                state.mediaStream = stream;
                prepVideo.srcObject = stream;
                prepVideo.classList.remove("hidden");
                prepPlaceholder.classList.add("hidden");
                prepCamBadge.classList.remove("hidden");

                prepStatusBox.className = "mt-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs";
                prepStatusBox.innerHTML = "<strong>Perangkat Siap!</strong> Kamera dan Mikrofon terdeteksi aktif. Anda dapat memulai ujian sekarang.";

                btnRequestMedia.classList.add("hidden");
                btnStartExam.disabled = false;
            } catch (err) {
                console.error("Media permission error:", err);
                handleMediaDenied("Akses Kamera atau Mikrofon ditolak. Siswa wajib mengizinkan Kamera & Mikrofon untuk mengikuti ujian.");
            }
        }

        function handleMediaDenied(message) {
            btnStartExam.disabled = true;
            prepVideo.classList.add("hidden");
            prepPlaceholder.classList.remove("hidden");
            prepCamBadge.classList.add("hidden");
            btnRequestMedia.classList.remove("hidden");

            prepStatusBox.className = "mt-3 p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs";
            prepStatusBox.innerHTML = `<strong>Akses Ditolak:</strong> ${message}`;
        }

        btnRequestMedia.addEventListener("click", requestMediaPermissions);

        function tryEnterFullscreen() {
            const elem = document.documentElement;
            const req = elem.requestFullscreen || elem.webkitRequestFullscreen || elem.msRequestFullscreen;
            if (req) {
                try {
                    const promise = req.call(elem);
                    if (promise && typeof promise.then === "function") {
                        promise
                            .then(() => {
                                state.wasFullscreenEntered = true;
                            })
                            .catch(err => {
                                console.warn("Fullscreen ditolak/tidak didukung browser:", err);
                            });
                    }
                } catch (err) {
                    console.warn("Gagal masuk fullscreen:", err);
                }
            }
        }

