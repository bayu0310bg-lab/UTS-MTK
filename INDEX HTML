        /**
         * =========================================================================
         * FLOATING CAMERA: DRAG & DROP (MOUSE + TOUCH) DENGAN BATASAN LAYAR
         * =========================================================================
         */
        const floatingCam = document.getElementById("floating-camera");
        let isDraggingCam = false;
        let camOffsetX = 0;
        let camOffsetY = 0;

        function initFloatingCameraPosition() {
            const margin = 12;
            const rect = floatingCam.getBoundingClientRect();
            const initLeft = Math.max(margin, window.innerWidth - rect.width - margin);
            const initTop = Math.max(margin, window.innerHeight - rect.height - 84);
            floatingCam.style.right = "auto";
            floatingCam.style.bottom = "auto";
            floatingCam.style.left = `${initLeft}px`;
            floatingCam.style.top = `${initTop}px`;
        }

        function clampCameraPosition(left, top) {
            const margin = 8;
            const maxLeft = window.innerWidth - floatingCam.offsetWidth - margin;
            const maxTop = window.innerHeight - floatingCam.offsetHeight - margin;
            return {
                x: Math.min(Math.max(margin, left), Math.max(margin, maxLeft)),
                y: Math.min(Math.max(margin, top), Math.max(margin, maxTop))
            };
        }

        function startDragCam(clientX, clientY) {
            isDraggingCam = true;
            const rect = floatingCam.getBoundingClientRect();
            camOffsetX = clientX - rect.left;
            camOffsetY = clientY - rect.top;
            floatingCam.style.right = "auto";
            floatingCam.style.bottom = "auto";
        }

        function moveDragCam(clientX, clientY) {
            if (!isDraggingCam) return;
            const pos = clampCameraPosition(clientX - camOffsetX, clientY - camOffsetY);
            floatingCam.style.left = `${pos.x}px`;
            floatingCam.style.top = `${pos.y}px`;
        }

        function endDragCam() {
            isDraggingCam = false;
        }

        // Mouse Events
        floatingCam.addEventListener("mousedown", (e) => {
            e.preventDefault();
            startDragCam(e.clientX, e.clientY);
        });
        window.addEventListener("mousemove", (e) => {
            if (isDraggingCam) moveDragCam(e.clientX, e.clientY);
        });
        window.addEventListener("mouseup", endDragCam);

        // Touch Events (HP/Tablet)
        floatingCam.addEventListener("touchstart", (e) => {
            if (e.touches.length > 0) {
                const t = e.touches[0];
                startDragCam(t.clientX, t.clientY);
            }
        }, { passive: true });

        window.addEventListener("touchmove", (e) => {
            if (!isDraggingCam || e.touches.length === 0) return;
            e.preventDefault();
            const t = e.touches[0];
            moveDragCam(t.clientX, t.clientY);
        }, { passive: false });

        window.addEventListener("touchend", endDragCam);

        // Jaga posisi kamera tetap di dalam layar saat orientasi/ukuran layar berubah
        window.addEventListener("resize", () => {
            if (floatingCam.classList.contains("hidden")) return;
            const rect = floatingCam.getBoundingClientRect();
            const pos = clampCameraPosition(rect.left, rect.top);
            floatingCam.style.left = `${pos.x}px`;
            floatingCam.style.top = `${pos.y}px`;
        });

        /**
         * =========================================================================
         * 5. PENGUMPULAN UJIAN & INTEGRASI GOOGLE SHEETS (APPS SCRIPT)
         * =========================================================================
         */
        const modalConfirmFinish = document.getElementById("modal-confirm-finish");

        document.getElementById("btn-finish-trigger").addEventListener("click", () => {
            const answeredCount = Object.keys(state.answers).length;
            const unansweredCount = QUESTIONS.length - answeredCount;
            document.getElementById("confirm-answered").textContent = answeredCount;
            document.getElementById("confirm-unanswered").textContent = unansweredCount;
