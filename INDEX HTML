        /**
         * =========================================================================
         * WEB AUDIO API SIREN GENERATOR (TANPA FILE MP3 EKSTERNAL)
         * =========================================================================
         */
        let audioCtx = null;
        let sirenOsc = null;
        let sirenGain = null;
        let sirenSweepInterval = null;
        let isSirenPlaying = false;

        function initAudioContext() {
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContextClass();
                }
                if (audioCtx.state === "suspended") {
                    audioCtx.resume();
                }
            } catch (err) {
                console.warn("Web Audio API tidak didukung:", err);
            }
        }

        function startSiren() {
            if (isSirenPlaying) return;
            try {
                initAudioContext();
                if (!audioCtx) return;

                sirenOsc = audioCtx.createOscillator();
                sirenGain = audioCtx.createGain();

                sirenOsc.type = "sawtooth";
                sirenOsc.frequency.setValueAtTime(700, audioCtx.currentTime);
                sirenGain.gain.setValueAtTime(0.28, audioCtx.currentTime);

                sirenOsc.connect(sirenGain);
                sirenGain.connect(audioCtx.destination);
                sirenOsc.start();
                isSirenPlaying = true;

                // Efek sirine naik-turun
                let high = true;
                sirenSweepInterval = setInterval(() => {
                    if (!audioCtx || !sirenOsc) return;
                    const now = audioCtx.currentTime;
                    const targetFreq = high ? 1150 : 620;
                    sirenOsc.frequency.linearRampToValueAtTime(targetFreq, now + 0.35);
                    high = !high;
                }, 380);
            } catch (err) {
                console.warn("Gagal menyalakan sirine:", err);
            }
        }

        function stopSiren() {
            if (!isSirenPlaying) return;
            try {
                if (sirenSweepInterval) {
                    clearInterval(sirenSweepInterval);
                    sirenSweepInterval = null;
                }
                if (sirenGain && audioCtx) {
                    sirenGain.gain.linearRampToValueAtTime(0.0001, audioCtx.currentTime + 0.08);
                }
                setTimeout(() => {
                    try {
                        if (sirenOsc) {
                            sirenOsc.stop();
                            sirenOsc.disconnect();
                            sirenOsc = null;
                        }
                        if (sirenGain) {
                            sirenGain.disconnect();
                            sirenGain = null;
                        }
                    } catch (_) {}
                }, 90);
            } catch (err) {
                console.warn("Gagal mematikan sirine:", err);
            } finally {
                isSirenPlaying = false;
            }
        }

        /**
