        function finishExam(statusText) {
            if (state.isFinished) return;
            state.isFinished = true;
            state.isExamActive = false;

            // Hentikan timer & alarm
            if (state.timerInterval) clearInterval(state.timerInterval);
            stopSiren();

            // Matikan kamera & mikrofon
            if (state.mediaStream) {
                state.mediaStream.getTracks().forEach(track => track.stop());
                state.mediaStream = null;
            }
            floatingCam.classList.add("hidden");

            // Keluar dari fullscreen jika aktif
            if (document.fullscreenElement) {
                document.exitFullscreen().catch(() => {});
            }

            // Hitung skor (maksimal 100)
            let correctCount = 0;
            const detailArray = [];

            QUESTIONS.forEach(q => {
                const userAns = state.answers[q.id] || "-";
                if (userAns === q.answer) correctCount += 1;
                detailArray.push(`${q.id}:${userAns}`);
            });

            const answeredCount = Object.keys(state.answers).length;
            const score = Math.round((correctCount / QUESTIONS.length) * 100 * 100) / 100;
            const timestamp = new Date().toLocaleString("id-ID", {
                dateStyle: "medium",
                timeStyle: "medium"
            });

            // Render halaman hasil
            const isDisqualified = statusText.includes("Diskualifikasi");
            const resultHeader = document.getElementById("result-header");
            resultHeader.className = isDisqualified
                ? "bg-rose-600 px-6 py-6 text-center text-white"
                : "bg-indigo-600 px-6 py-6 text-center text-white";

            document.getElementById("result-status-badge").textContent = `Status: ${statusText}`;
            document.getElementById("result-score").textContent = score;
            document.getElementById("result-nama").textContent = state.nama;
            document.getElementById("result-kelas").textContent = state.kelas;
            document.getElementById("result-correct").textContent = `${correctCount} / ${QUESTIONS.length}`;
            document.getElementById("result-answered").textContent = `${answeredCount} / ${QUESTIONS.length}`;

            // Tampilkan halaman hasil ujian
            showView("view-result");

            // Siapkan payload lengkap yang sinkron 1-to-1 dengan Google Apps Script (Code.gs)
            const payload = {
                waktu: timestamp,
                mapel: "Matematika",
                nama: state.nama,
                kelas: state.kelas,
                skor: score,
                status: statusText,
                jumlah_benar: correctCount,
                jumlah_salah: QUESTIONS.length - correctCount,
                jumlah_terjawab: `${answeredCount}/${QUESTIONS.length}`,
                pelanggaran: state.violationCount,
                detail_jawaban: detailArray.join(", ")
            };

            state.lastPayload = payload;
            sendDataToGoogleSheets(payload);
        }

        async function sendDataToGoogleSheets(payload) {
            const box = document.getElementById("sync-status-box");
            const spinner = document.getElementById("sync-spinner");
            const text = document.getElementById("sync-status-text");
            const sub = document.getElementById("sync-status-sub");
            const btnRetry = document.getElementById("btn-retry-sync");

            // Status: Mengirim data...
            box.className = "p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-sm flex items-center justify-between gap-3";
            spinner.classList.remove("hidden");
            btnRetry.classList.add("hidden");
            text.textContent = "Mengirim data...";
            sub.textContent = "Menyimpan hasil ujian ke Google Spreadsheets";

            try {
                // Jika URL masih dummy, lakukan simulasi agar alur UI tetap dapat diuji
                if (GOOGLE_SCRIPT_URL.includes("GANTI_DENGAN_URL_WEB_APP")) {
                    await new Promise(resolve => setTimeout(resolve, 1200));
                    console.info("Payload siap dikirim ke Google Sheets:", payload);
                    showSyncSuccess("Mode Simulasi: Ganti GOOGLE_SCRIPT_URL dengan URL Apps Script Anda.");
                    return;
                }

                // Kirim POST ke Google Apps Script Webhook
                await fetch(GOOGLE_SCRIPT_URL, {
                    method: "POST",
                    mode: "no-cors",
                    headers: {
                        "Content-Type": "text/plain;charset=utf-8"
                    },
                    body: JSON.stringify(payload)
                });

                showSyncSuccess("Hasil ujian Anda telah tersimpan di Google Spreadsheets.");
            } catch (err) {
                console.error("Gagal mengirim ke Google Sheets:", err);
                box.className = "p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between gap-3";
                spinner.classList.add("hidden");
                text.textContent = "Gagal mengirim data";
                sub.textContent = "Periksa koneksi internet Anda lalu coba lagi.";
                btnRetry.classList.remove("hidden");
            }
        }

        function showSyncSuccess(subText) {
            const box = document.getElementById("sync-status-box");
            const spinner = document.getElementById("sync-spinner");
            const text = document.getElementById("sync-status-text");
            const sub = document.getElementById("sync-status-sub");

            box.className = "p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between gap-3";
            spinner.classList.add("hidden");
            text.textContent = "Data berhasil terkirim";
            sub.textContent = subText;
        }

        document.getElementById("btn-retry-sync").addEventListener("click", () => {
            if (state.lastPayload) sendDataToGoogleSheets(state.lastPayload);
        });

        // Salin bukti hasil ujian menggunakan document.execCommand('copy') agar aman di semua browser/iframe
        document.getElementById("btn-copy-result").addEventListener("click", () => {
            if (!state.lastPayload) return;
            const p = state.lastPayload;
            const summary = [
                "=== BUKTI HASIL STS MATEMATIKA VIII ===",
                `Waktu: ${p.waktu}`,
                `Nama: ${p.nama}`,
                `Kelas: ${p.kelas}`,
                `Skor: ${p.skor}`,
                `Status: ${p.status}`,
                `Terjawab: ${p.jumlah_terjawab} (Benar: ${p.jumlah_benar})`,
                `Pelanggaran: ${p.pelanggaran}x`
            ].join("\n");

            const tempArea = document.createElement("textarea");
            tempArea.value = summary;
            tempArea.style.position = "fixed";
            tempArea.style.opacity = "0";
            document.body.appendChild(tempArea);
            tempArea.select();
            try {
                document.execCommand("copy");
                const label = document.getElementById("btn-copy-result-text");
                label.textContent = "Bukti Hasil Berhasil Disalin!";
                setTimeout(() => {
                    label.textContent = "Salin Bukti Hasil Ujian";
                }, 2500);
            } catch (err) {
                console.warn("Gagal menyalin teks:", err);
            } finally {
                document.body.removeChild(tempArea);
            }
        });
    </script>
</body>
</html>
