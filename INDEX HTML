        function startTimer() {
            updateTimerDisplay();
            state.timerInterval = setInterval(() => {
                if (!state.isExamActive || state.isFinished) return;
                state.timeLeft -= 1;
                updateTimerDisplay();

                if (state.timeLeft <= 0) {
                    clearInterval(state.timerInterval);
                    finishExam("Waktu Habis");
